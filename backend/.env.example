# Admin token for reviewing price corrections
ADMIN_TOKEN=peizhi-admin-dev

# SerpApi key for live shopping prices (optional; without it only catalog + links work)
SERPAPI_API_KEY=

# Auto-verify corrections within this deviation of catalog/list price (0.4 = 40%)
PRICE_AUTO_VERIFY_THRESHOLD=0.40

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./peizhi.db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
